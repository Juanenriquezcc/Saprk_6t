# --- Offline kit (≈600 MB, regenerated with: run.cmd -PrepareKit) ---------------
# Not versioned: the PySpark wheel (430 MB) exceeds GitHub's 100 MB file limit and
# these are third-party binaries. The kit travels on the USB drive.
tools/
wheels/

# --- Generated per PC / per run --------------------------------------------------
.venv/
venv/
exports/
spark-warehouse/
metastore_db/
derby.log
*.log

# --- Python / test caches -----------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# --- Real lab data (may be private; see tests/test_lab_real.py) ----------------
tests/data/lab_real/

# --- Editors / OS ------------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
